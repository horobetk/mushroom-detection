# Mushroom Recognition Project - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# PyCharm
.idea/

# VS Code
.vscode/

# Mac
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Data files (often too large for git)
data/raw/*.mp4
data/raw/*.avi
data/raw/*.mov
data/raw/*.mkv
data/frames/**/*.jpg
data/frames/**/*.png

# Annotations (can be large)
data/annotations/train/**
data/annotations/val/**

# Model files (too large for git)
*.pt
*.pth
*.onnx
*.tflite
*.pb
runs/
weights/

# Logs
*.log
logs/
wandb/

# Temporary files
*.tmp
*.bak
*.swp
*~

# Android
android/app/build/
android/.gradle/
android/local.properties
*.apk
*.aab

# Documentation
docs/_build/
