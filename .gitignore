# Mushroom Recognition Project - .gitignore

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env

# Secrets / API credentials
kaggle.json
*.kaggle.json

# Temporary logs
*_log.txt
install_log.txt

# ML Artifacts (Local only)
runs/
datasets/
*.pt
*.pth
*.onnx
*.tflite
*.pb
weights/

# Project Snapshots (For AI assistant)
project_snapshot.txt
scripts/project_snapshot.py

# Data (Videos and large frame sets)
data/raw/**
data/external/
data/processed/
data/frames/augmented/
data/frames/rejected/
data/frames/original/*.txt
data/frames/original/*.jpg

# Exceptions for Data (Keep placeholders)
!data/raw/.gitkeep
!data/frames/original/.gitkeep
!data/frames/augmented/.gitkeep
!data/frames/rejected/.gitkeep

# IDE & OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Android Build
android/app/build/
android/.gradle/
android/local.properties
*.apk
*.aab